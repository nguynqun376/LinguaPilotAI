rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profile records
    match /users/{userId} {
      allow read, write: if true;
    }
    
    // Study and telemetry data records
    match /study_data/{userId} {
      allow read, write: if true;
    }
    
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
